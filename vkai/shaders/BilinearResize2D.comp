#version 450

layout(binding = 0) uniform UniformBufferObject {
    int input_width;
    int input_height;
    int input_channels;
    int batch_size;
    int output_width;
    int output_height;
    int reserved_0;
    int reserved_1;
} ubo;

layout(binding = 1, std430) readonly buffer InputBuffer { float input_buffer[]; };
layout(binding = 2, std430) writeonly buffer OutputBuffer { float output_buffer[]; };
layout(local_size_x = 256) in;

float ReadInput(int batch, int channel, int y, int x) {
    int index = ((batch * ubo.input_channels + channel) * ubo.input_height + y) *
                ubo.input_width + x;
    return input_buffer[index];
}

void main() {
    uint output_index = gl_GlobalInvocationID.x;
    uint output_count = uint(ubo.batch_size * ubo.input_channels *
                             ubo.output_height * ubo.output_width);
    if (output_index >= output_count) return;

    uint remaining = output_index;
    int output_x = int(remaining % uint(ubo.output_width));
    remaining /= uint(ubo.output_width);
    int output_y = int(remaining % uint(ubo.output_height));
    remaining /= uint(ubo.output_height);
    int channel = int(remaining % uint(ubo.input_channels));
    int batch = int(remaining / uint(ubo.input_channels));

    float source_y = (float(output_y) + 0.5) * float(ubo.input_height) /
                     float(ubo.output_height) - 0.5;
    float source_x = (float(output_x) + 0.5) * float(ubo.input_width) /
                     float(ubo.output_width) - 0.5;
    int top_unclamped = int(floor(source_y));
    int left_unclamped = int(floor(source_x));
    float y_weight = source_y - float(top_unclamped);
    float x_weight = source_x - float(left_unclamped);
    int top = clamp(top_unclamped, 0, ubo.input_height - 1);
    int left = clamp(left_unclamped, 0, ubo.input_width - 1);
    int bottom = clamp(top_unclamped + 1, 0, ubo.input_height - 1);
    int right = clamp(left_unclamped + 1, 0, ubo.input_width - 1);

    float top_value = mix(ReadInput(batch, channel, top, left),
                          ReadInput(batch, channel, top, right), x_weight);
    float bottom_value = mix(ReadInput(batch, channel, bottom, left),
                             ReadInput(batch, channel, bottom, right), x_weight);
    output_buffer[output_index] = mix(top_value, bottom_value, y_weight);
}
