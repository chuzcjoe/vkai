#version 450

layout(binding = 0) uniform UniformBufferObject {
    int input_width;
    int input_height;
    int input_channels;
    int batch_size;
    int output_width;
    int output_height;
    int reserved_0;
    int reserved_1;
} ubo;

layout(binding = 1, std430) readonly buffer InputBuffer { float input_buffer[]; };
layout(binding = 2, std430) writeonly buffer OutputBuffer { float output_buffer[]; };
layout(local_size_x = 256) in;

void main() {
    uint output_index = gl_GlobalInvocationID.x;
    uint output_count = uint(ubo.batch_size * ubo.input_channels *
                             ubo.output_height * ubo.output_width);
    if (output_index >= output_count) return;

    uint remaining = output_index;
    int output_x = int(remaining % uint(ubo.output_width));
    remaining /= uint(ubo.output_width);
    int output_y = int(remaining % uint(ubo.output_height));
    remaining /= uint(ubo.output_height);
    int channel = int(remaining % uint(ubo.input_channels));
    int batch = int(remaining / uint(ubo.input_channels));

    int input_y_start = output_y * ubo.input_height / ubo.output_height;
    int input_y_end = ((output_y + 1) * ubo.input_height + ubo.output_height - 1) /
                      ubo.output_height;
    int input_x_start = output_x * ubo.input_width / ubo.output_width;
    int input_x_end = ((output_x + 1) * ubo.input_width + ubo.output_width - 1) /
                      ubo.output_width;
    float sum = 0.0;
    for (int input_y = input_y_start; input_y < input_y_end; ++input_y) {
        for (int input_x = input_x_start; input_x < input_x_end; ++input_x) {
            int input_index = ((batch * ubo.input_channels + channel) * ubo.input_height +
                               input_y) * ubo.input_width + input_x;
            sum += input_buffer[input_index];
        }
    }
    output_buffer[output_index] = sum / float((input_y_end - input_y_start) *
                                               (input_x_end - input_x_start));
}
